; Engine configuration file.
; Prismaze — Android-first offline gameplay optical puzzle
; Godot 4.7.x

config_version=5

[application]

config/name="Prismaze"
config/description="Android-first offline gameplay optical puzzle game"
run/main_scene="res://scenes/boot/boot.tscn"
config/icon="res://assets/art/icon.svg"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_mouse_from_touch=false
